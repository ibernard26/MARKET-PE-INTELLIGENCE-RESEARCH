# Free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_key_here
PE_TRACKER_DB=data/pe_tracker.db
# Required for SEC EDGAR + company_tickers.json (fair-access contact string)
SEC_USER_AGENT=MARKET-PE-INTELLIGENCE-RESEARCH you@example.com

# Free thesis data stack (OpenFIGI identity + Tiingo EOD). Never commit real values.
# Cloud Agents: set these as Runtime Secrets / Environment Variables in the
# Cursor Secrets tab, then start a new agent (existing pods do not pick them up).
OPENFIGI_API_KEY=your_openfigi_key_here
TIINGO_API_TOKEN=your_tiingo_token_here
